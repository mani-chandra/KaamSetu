# Database (PostgreSQL — use Docker locally: docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaamsetu"
# Legacy local SQLite (switch prisma provider to sqlite first):
# DATABASE_URL="file:./dev.db"

# NextAuth (required)
AUTH_SECRET="generate-a-long-random-secret-for-production"
AUTH_URL="http://localhost:3000"

# Razorpay (optional — demo mode without keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Resend (optional — console fallback in dev)
RESEND_API_KEY=""
EMAIL_FROM="KaamSetu <noreply@kaamsetu.com>"

# SMS via MSG91 (optional — console fallback in dev)
MSG91_API_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# Cloudinary (production uploads on Vercel)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional fallback — unsigned preset if API secret is not set
CLOUDINARY_UPLOAD_PRESET=""
